# Expo app environment (copy to `.env` and fill in values).
# Never commit `.env` — it is gitignored.

# Supabase (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Superadmin MFA login hint (must match DB migration designated email)
EXPO_PUBLIC_DESIGNATED_SUPERADMIN_EMAIL=you@example.com

# Set to true after PayHere edge functions are deployed (enables PayHere tab + withdraw)
EXPO_PUBLIC_PAYHERE_ENABLED=false

# Firebase web push (PWA) — OPTIONAL: auto-loaded from google-services.json + Supabase edge
# `firebase-web-config`. Only set these if you need to override defaults.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase mobile config file paths (used by app.config.js at build time)
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist

# --- NOT for this file (set on Supabase Edge Function secrets instead) ---
# RESEND_API_KEY, RESEND_FROM_EMAIL, OTP_AES_KEY, FIREBASE_SERVICE_ACCOUNT_JSON
# SUPABASE_SERVICE_ROLE_KEY
# PAYHERE_MERCHANT_ID, PAYHERE_MERCHANT_SECRET, PAYHERE_SANDBOX=true
# SMSlenz.lk (signup OTP SMS) — https://smslenz.lk/developers/api
# Set ONLY in Supabase Dashboard → Edge Functions → Secrets (never commit, never EXPO_PUBLIC_*):
#   SMSLENZ_USER_ID
#   SMSLENZ_API_KEY
#   SMSLENZ_SENDER_ID=MyTuition
#   SMSLENZ_API_BASE_URL=https://smslenz.lk/api
# ALLOW_CONSOLE_OTP=true  (local/dev only)
# If an API key was pasted in chat/email, click Refresh on SMSlenz Settings → API first.
