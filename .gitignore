# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Firebase / FCM (never commit service account JSON or mobile config with secrets)
firebase-service-account.json
*-firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# local env files (NEVER commit .env — keep secrets out of git)
.env
.env.*
!.env.example

# Supabase CLI (linked project metadata; may include connection details)
supabase/.temp/

# typescript
*.tsbuildinfo

app-example

# nested scaffold copy (not part of XEN app)
xen/

# generated native folders
/ios
/android

.vercel

# local APK staging (never commit)
/tmp-apk/
